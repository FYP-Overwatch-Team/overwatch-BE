APP_ENV=dev
# the brand users see: overwatch or bearings
PRODUCT_NAME=overwatch
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=overwatch_dev

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword

# GitHub App (see README: "GitHub App")
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=

# Atlassian OAuth 2.0 (3LO) app
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# AI model: any OpenAI-compatible API (OpenRouter, Groq, ...)
MODEL_API_KEY=
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=deepseek/deepseek-v4.1-flash
# sent as `reasoning_effort`; leave empty for a provider that rejects it
MODEL_REASONING_EFFORT=low
# AI chat limits. A question counts once against the hourly and workspace limits; every model call
# it makes (one, plus one per round of looking things up) counts against the daily budget.
CHAT_USER_HOURLY_LIMIT=30
CHAT_WORKSPACE_DAILY_LIMIT=200
CHAT_DAILY_BUDGET=500
DECISION_SUGGEST_WORKSPACE_DAILY_LIMIT=20
DECISION_CHECK_WORKSPACE_DAILY_LIMIT=20
DECISION_CHECK_INTERVAL_SECONDS=1800
# lookups (graph search, reading code) one answer may make before it must answer; 0 turns them off
CHAT_MAX_LOOKUPS=20
# OpenRouter only: keep a conversation's calls on one provider (its cache stays warm), and optionally
# sort providers by latency/throughput/price. MODEL_PROVIDER_ORDER pins slugs but turns off cache-warm routing.
MODEL_SESSION_ROUTING=true
MODEL_PROVIDER_SORT=
MODEL_PROVIDER_ORDER=
REPOS_DIR=./repos

# Uploaded files (doc images): "local" keeps them in UPLOADS_DIR (dev); "s3" (AWS) or "r2" (Cloudflare) use the bucket.
# Credentials come from AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (an R2 API token's pair on R2) or the instance role.
# AWS: leave STORAGE_ENDPOINT_URL empty. R2: STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com, STORAGE_REGION=auto.
# The bucket stays private and needs CORS allowing GET plus POST (S3) or PUT (R2) from FRONTEND_ORIGIN.
# Keys read as folders: workspaces/<workspace_id>/docs/<page_id>/images/<attachment_id>.<ext> (app/storage/keys.py).
STORAGE_BACKEND=local
UPLOADS_DIR=./uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=

# Docs mirrored from a source (Confluence): edits go back once nobody has typed for DOC_PUSH_IDLE_SECONDS,
# checked every DOC_PUSH_INTERVAL_SECONDS; archived docs are deleted for good after DOC_ARCHIVE_RETENTION_DAYS.
DOC_PUSH_IDLE_SECONDS=20
DOC_PUSH_INTERVAL_SECONDS=10
DOC_ARCHIVE_RETENTION_DAYS=30

# Document spaces polling interval (Confluence -> Bearings)
DOC_SYNC_INTERVAL_SECONDS=30

# Tracker polling interval (Jira boards and sprints)
TICKET_SYNC_INTERVAL_SECONDS=120
SYNC_LOCK_STALE_MINUTES=15

# Email: console (logs) or smtp. For Gmail, turn on 2FA and use an App Password.
EMAIL_BACKEND=console
EMAIL_FROM=
# empty sends as the product name
EMAIL_FROM_NAME=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
HIBP_ENABLED=true
INVITE_EMAIL_DAILY_LIMIT_WORKSPACE=50
INVITE_EMAIL_DAILY_LIMIT_USER=100
