APP_ENV=dev
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=overwatch_dev

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword

# GitHub App (see README: "GitHub App")
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=

# Atlassian OAuth 2.0 (3LO) app
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

GEMINI_API_KEY=
# AI chat limits; keep the daily budget below the Gemini project's daily quota
CHAT_USER_HOURLY_LIMIT=30
CHAT_WORKSPACE_DAILY_LIMIT=200
CHAT_DAILY_BUDGET=500
REPOS_DIR=./repos

# Uploaded files (doc images): "local" keeps them in UPLOADS_DIR (dev); "s3" uses the bucket.
# On S3, AWS credentials come from the usual sources (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY or the instance role).
# The bucket needs CORS allowing POST from FRONTEND_ORIGIN, and should stay private.
STORAGE_BACKEND=local
UPLOADS_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=

# Docs mirrored from a source (Confluence): edits go back once nobody has typed for DOC_PUSH_IDLE_SECONDS,
# checked every DOC_PUSH_INTERVAL_SECONDS; archived docs are deleted for good after DOC_ARCHIVE_RETENTION_DAYS.
DOC_PUSH_IDLE_SECONDS=60
DOC_PUSH_INTERVAL_SECONDS=10
DOC_ARCHIVE_RETENTION_DAYS=30

# Tracker and docs syncs: the polling loop's interval, and when a sync still marked running counts as lost
TICKET_SYNC_INTERVAL_SECONDS=120
SYNC_LOCK_STALE_MINUTES=15

# Email: console (logs) or smtp. For Gmail, turn on 2FA and use an App Password.
EMAIL_BACKEND=console
EMAIL_FROM=
EMAIL_FROM_NAME=Overwatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
HIBP_ENABLED=true
INVITE_EMAIL_DAILY_LIMIT_WORKSPACE=50
INVITE_EMAIL_DAILY_LIMIT_USER=100
